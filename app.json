{
  "expo": {
    "name": "Meowalaf",
    "slug": "meowalaf",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "meowalaf",
    "backgroundColor": "#0B0F0E",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0B0F0E"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#0B0F0E",
      "package": "id.meowalaf.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F0E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#E0B44A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": "production"
        }
      }
    }
  }
}
