{
  "name": "meowalaf",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "serve:web": "npx --yes serve dist -l 8132 --no-clipboard",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:budget": "node scripts/perf-budget.mjs",
    "content:build": "tsx scripts/build-content/main.ts",
    "content:fetch": "tsx scripts/build-content/main.ts --fetch",
    "content:mcp-check": "tsx scripts/build-content/mcp-check.ts",
    "content:word-data": "tsx scripts/build-content/main-word-data.ts",
    "content:word-gloss": "tsx scripts/build-content/main-word-gloss.ts",
    "deploy:web": "vercel deploy --prod --yes",
    "deploy:web:preview": "vercel deploy --yes",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "prebuild": "expo prebuild --clean",
    "fonts:subset": "node scripts/fonts/subset-fonts.mjs",
    "brand:icons": "node scripts/brand/render-icons.mjs",
    "brand:mascot-preview": "tsx scripts/brand/mascot-preview.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "adhan": "^4.4.6",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-react-hooks": "^6",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "subset-font": "^2.9.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  }
}
